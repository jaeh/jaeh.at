{
  "name": "jaeh.at",
  "version": "0.23.5",
  "private": true,
  "keywords": [
    "ehrenreich",
    "jaeh",
    "jascha",
    "magic"
  ],
  "homepage": "https://github.com/jaeh/jaeh.at#readme",
  "bugs": {
    "url": "https://github.com/jaeh/jaeh.at/issues"
  },
  "license": "AGPL-3.0",
  "author": "Jascha Ehrenreich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaeh/jaeh.at.git"
  },
  "type": "module",
  "scripts": {
    "start": "t -p",
    "format": "f -w --exclude docs",
    "test": "t --exclude docs",
    "build": "NODE_ENV=production magic build --no-check-links-exit",
    "prod": "NODE_ENV=production magic build serve --no-check-links-exit",
    "dev": "magic dev",
    "publish": "magic publish",
    "connect": "magic connect",
    "lint": "lint"
  },
  "dependencies": {
    "@magic-modules/language-switch": "0.0.6",
    "@magic-modules/light-switch": "0.0.12",
    "@magic-modules/no-spy": "0.0.9",
    "@magic-modules/p": "0.0.1",
    "@magic-modules/picture": "0.0.2",
    "@magic/core": "0.0.162"
  },
  "devDependencies": {
    "@magic/format": "0.0.82",
    "@magic/lint": "0.0.6",
    "@magic/test": "0.3.59"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true
  }
}
